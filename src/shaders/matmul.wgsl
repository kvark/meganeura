// @section header
// Register-tiled matmul: C = A × B (+ D if fused_add)
// One skeleton for every tile (BM=$BM_U, BN=$BN_U, KTILE=$K_TILE_U, workgroup
// [16,16,1]). The register tile is (BM/16) by (BN/16): TM=TN=4 with 16
// accumulators for 64×64, TM=TN=2 with 4 accumulators for 32×32, and
// TM=TN=8 with 64 accumulators for 128×128. The unrolled accumulator
// declarations, FMA body, and store array are generated by
// `codegen::tiled_matmul_body`.
//
// Shared memory uses padded strides to distribute consecutive rows across
// banks. The per-thread register mapping still affects bank conflicts;
// codegen supplies the column mapping for both shared reads and output stores.
//
// Template variables: BM_U/TM_U/B_STRIDE_U/STAGE_EPT_U and shared sizes
// (tile geometry), A_INDEX/B_INDEX (global index), A_ROW/COL, B_ROW/COL
// (tile mapping), TILE_ROW/C_INDEX (dispatch/storage layout),
// ACC_DECL/COMPUTE_BODY/ACC_ARRAY (generated unrolls),
// FUSED_ADD_DECL/STORE_BODY (addend/epilogue), B_* (weight format).

$ENABLE_F16
const SPLITS: u32 = $SPLITS_U;
struct Params {
    m: u32,
    n: u32,
    k: u32,
    _pad: u32,
}

var<storage> matrix_a: array<f32>;
$MATRIX_BINDINGS
$FUSED_ADD_DECL
var<uniform> params: Params;
var<workgroup> shared_a: array<$SHARED_ELEM, $SHARED_A_SIZE>;
var<workgroup> shared_b: array<$SHARED_ELEM, $SHARED_B_SIZE>;
$B_DEQUANT_FN

// @section kernel
$ENTRY_SIGNATURE {
    let tx = lid.x;
    let ty = lid.y;
    let raw_row = select(($TILE_ROW), wgid.y, SPLITS > 1u);
    let grid_x = (params.n + $BN_U - 1u) / $BN_U;
    let grid_y = (params.m + $BM_U - 1u) / $BM_U;
    let swizzle_idx = (raw_row & 7u) * grid_x + wgid.x;
    let in_swizzle = raw_row < (grid_y & ~7u);
    let tile_row = select(raw_row, (raw_row & ~7u) + (swizzle_idx & 7u), in_swizzle) * $BM_U;
    let tile_col = select(wgid.x, swizzle_idx >> 3u, in_swizzle) * $BN_U;
    let tid = ty * $WG_X_U + tx;
    let warp_row = $WARP_ROW_EXPR;
    let warp_col = $WARP_COL_EXPR;

    $ACC_DECL

    let split_id = select(0u, wgid.z, SPLITS > 1u);
    let tiles = (params.k + $K_TILE_U - 1u) / $K_TILE_U;
    let first_tile = (tiles / SPLITS) * split_id + min(split_id, tiles % SPLITS);
    let end_tile = (tiles / SPLITS) * (split_id + 1u) + min(split_id + 1u, tiles % SPLITS);
    let end_k = min(end_tile * $K_TILE_U, params.k);
    let full_wg = (tile_row + $BM_U <= params.m) && (tile_col + $BN_U <= params.n);
    var t = first_tile * $K_TILE_U;
    if full_wg && (t + $K_TILE_U <= end_k) {
$FAST_LOOP_BODY
    }
    loop {
        if t >= end_k { break; }

        $STAGE_BODY
        workgroupBarrier();

        let k_rem = select($K_TILE_U, params.k, params.k == 0u);
        for (var kk = 0u; kk < k_rem; kk += 1u) {
            $TAIL_COMPUTE_BODY
        }

        workgroupBarrier();
        t += $K_TILE_U;
    }

    // Store results with bounds check and optional fused epilogue
    $STORE_UNROLLED
}
